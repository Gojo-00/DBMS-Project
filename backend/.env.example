DATABASE_URL=mysql://root:your_password@localhost:3306/EcommerceDB
HOST=127.0.0.1
PORT=3000
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Create a random secret of at least 32 characters. Do not commit backend/.env.
OTP_HASH_SECRET=replace_with_a_random_secret_of_at_least_32_characters

# Gmail API over HTTPS (preferred when all three variables are set).
# OAuth scope: https://www.googleapis.com/auth/gmail.send
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Resend HTTPS fallback. The onboarding sender is for testing only;
# production recipients require a sender/domain verified in Resend.
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM=SwiftCart <onboarding@resend.dev>

# Twilio SMS (required only for phone OTP delivery).
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace_with_twilio_auth_token
TWILIO_FROM_NUMBER=+12345678900
